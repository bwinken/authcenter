[Unit]
Description=AuthCenter FastAPI Application
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/opt/authcenter
EnvironmentFile=%h/opt/authcenter/.env
# 如需透過 Proxy 連外網（uv sync / webhook），取消下方註解
# Environment="HTTP_PROXY=http://proxy.company.com:8080"
# Environment="HTTPS_PROXY=http://proxy.company.com:8080"
# Environment="NO_PROXY=localhost,127.0.0.1"
ExecStart=%h/.local/bin/uv run fastapi run app/main.py \
    --host 127.0.0.1 \
    --port ${APP_PORT} \
    --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
