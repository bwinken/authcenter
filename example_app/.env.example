# Auth Center 位址
AUTH_CENTER_BASE_URL=http://localhost:8000

# 在 Auth Center apps.yaml 中註冊的 App ID
APP_ID=ai_chat_app

# App 的明文密鑰（對應 apps.yaml 中的 bcrypt hash）
CLIENT_SECRET=chat_secret_123

# OAuth2 callback URL（需與 apps.yaml 中的 redirect_uri 一致）
REDIRECT_URI=http://localhost:8001/auth/callback

# Auth Center 的 RS256 公鑰路徑
PUBLIC_KEY_PATH=./keys/public.pem
