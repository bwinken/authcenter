# Auth Center 位址
AUTH_CENTER_BASE_URL=http://localhost:8000

# 在 Auth Center apps.yaml 中註冊的 App ID
APP_ID=ai_chat_app

# App 的明文密鑰（對應 apps.yaml 中的 bcrypt hash）
CLIENT_SECRET=chat_secret_123

# OAuth2 callback URL（需與 apps.yaml 中的 redirect_uri 一致）
REDIRECT_URI=http://localhost:8001/auth/callback

# Auth Center 的 RS256 公鑰路徑
PUBLIC_KEY_PATH=./keys/public.pem

# ── 以下為 security_tests.py 使用（可選，有預設值）──

# 測試帳號（必須已在 MSSQL + Auth Center 註冊）
# TEST_USER=testuser
# TEST_PASSWORD=Test1234

# 第二個 App（跨 App 測試用，只需在 apps.yaml 註冊，不需部署）
# APP2_ID=test_app
# APP2_SECRET=test_secret
# APP2_REDIRECT=http://localhost:8001/callback

# 限定組織的 App（組織邊界測試用，只需在 apps.yaml 註冊，不需部署）
# ORG_RESTRICTED_APP_ID=ai_report_app
# ORG_RESTRICTED_SECRET=report_secret_456
# ORG_RESTRICTED_REDIRECT=http://localhost:8002/auth/callback
