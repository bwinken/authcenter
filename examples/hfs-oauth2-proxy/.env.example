# ============================================================
# OAuth2 Proxy + HFS 環境變數設定
# ============================================================
# 使用方式: cp .env.example .env && 編輯填入實際值
# ============================================================

# ─── OIDC Provider (AuthCenter) ───
# AuthCenter 的對外 URL（必須與 AuthCenter .env 的 AUTH_CENTER_BASE_URL 一致）
OIDC_ISSUER_URL=https://auth.company.com

# ─── Client 憑證 ───
# 在 AuthCenter 註冊的 App ID 和明文 Client Secret
# （AuthCenter 的 apps.yaml 中存 bcrypt hash，這裡填明文）
CLIENT_ID=hfs_file_server
CLIENT_SECRET=your_client_secret_here

# ─── Redirect URL ───
# OAuth2 Proxy 的 callback URL（必須與 AuthCenter apps.yaml 的 redirect_uri 完全一致）
REDIRECT_URL=https://files.company.com/oauth2/callback

# ─── Cookie Secret ───
# Session Cookie 的加密密鑰（必須 32 bytes base64 編碼）
# 產生方式: openssl rand -base64 32
COOKIE_SECRET=

# ─── 內網 DNS 對應（Docker 容器無法解析內網 alias 時設定）───
# 格式：hostname:ip（例如 auth.company.com:192.168.1.100）
# 留空表示不需要（AuthCenter 有正式 DNS 記錄時）
# 使用 setup.sh 時會自動處理；手動部署請參考 README
OIDC_EXTRA_HOST=

# ─── HFS 設定（可選）───
HFS_ADMIN_USER=admin
HFS_ADMIN_PASSWORD=changeme
