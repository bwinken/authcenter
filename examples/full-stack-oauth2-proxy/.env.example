# ============================================================
# 環境變數設定 — 全端整合 (OAuth2 Proxy + 業務 API + HFS 檔案伺服器)
# ============================================================
# 複製此檔案為 .env，並填入實際值：
#   cp .env.example .env
# ============================================================

# ─── AuthCenter OIDC 設定 ───
# AuthCenter 的對外 URL（必須與 AUTH_CENTER_BASE_URL 一致）
OIDC_ISSUER_URL=http://auth.company.com

# 在 AuthCenter apps.yaml 中註冊的 Client ID
CLIENT_ID=sa_help

# Client Secret（明文，apps.yaml 中存的是 bcrypt hash）
CLIENT_SECRET=your-client-secret-here

# OAuth2 callback URL（必須與 apps.yaml 的 redirect_uri 一致）
# 所有路徑（/, /api/, /fs/）共用這一個 callback
REDIRECT_URL=http://sa-help.company.com/oauth2/callback

# ─── Cookie 設定 ───
# 加密密鑰 — 用以下指令產生: openssl rand -base64 32 | head -c 32
COOKIE_SECRET=

# Cookie 有效時間 — 應與 AuthCenter 的 token_expire_hours 一致
# oauth2-proxy 預設 168h (7天)，會導致 cookie 比 JWT token 更久存活
# 建議設為與 AuthCenter app 設定的 token_expire_hours 相同值
COOKIE_EXPIRE=12h

# ─── HFS 檔案伺服器 ───
HFS_ADMIN_USER=admin
HFS_ADMIN_PASSWORD=changeme

# ─── 業務 API 後端 ───
# 如果後端不在 Docker 中，填入 host 上的 port
BACKEND_API_PORT=8058

# ─── 內網 DNS（選填）───
# 如果 Docker 容器無法解析 AuthCenter 的域名，取消註解並填入 IP
# OIDC_EXTRA_HOST=auth.company.com:192.168.1.100
