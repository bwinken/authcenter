# === IT Master DB (MSSQL - Read Only) ===
MSSQL_HOST=192.168.1.100
MSSQL_PORT=1433
MSSQL_USER=readonly_user
MSSQL_PASSWORD=your_mssql_password
MSSQL_DATABASE=it_master
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TABLE=staff

# === Auth Local DB (SQLite) ===
SQLITE_PATH=./auth_local.db

# === RSA Keys ===
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

# === Microsoft Teams Webhook ===
# 管理員 Channel 通知（註冊請求、忘記密碼等）
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/xxx
# HTTP Proxy（內網環境需透過 Proxy 連外網時設定）
# HTTP_PROXY=http://proxy.company.com:8080

# === 自動寄信（Exchange EWS，可選）===
# 以下 4 項與 COMPANY_EMAIL_DOMAIN 都設定後，員工申請註冊／忘記密碼時，
# 系統會自動把連結寄到 <nt_account>@<COMPANY_EMAIL_DOMAIN>，並把寄送結果通知 Teams Webhook。
# 未設定時維持原流程（Teams 通知管理員手動產生連結）。
# 帳號與密碼請用單引號包住：systemd 的 EnvironmentFile 會吃掉沒加引號的反斜線（DOMAIN\user → DOMAINuser）
# 正式環境建議使用專用服務帳號；若服務有設定 HTTPS_PROXY，請把 Exchange 主機加進 NO_PROXY
# COMPANY_EMAIL_DOMAIN=company.com
# EXCHANGE_SERVER=mail.company.com
# EXCHANGE_USER='DOMAIN\username'
# EXCHANGE_PASSWORD='your_exchange_password'
# EXCHANGE_EMAIL=noreply@company.com

# === Keycloak 登入（可選）===
# 設定 KEYCLOAK_ISSUER 與 KEYCLOAK_CLIENT_ID 後，可在 config/apps.yaml 以 auth_provider 指定
# 哪些 App 改由 Keycloak 驗證身分（keycloak = 只能用 Keycloak，both = Keycloak 或 AuthCenter 密碼）。
# 未設定時所有 App 維持 AuthCenter 密碼登入。
# Keycloak client 的 Valid redirect URIs 需登記 <AUTH_CENTER_BASE_URL>/auth/keycloak/callback
# KEYCLOAK_ISSUER=https://keycloak.company.com/realms/your-realm
# KEYCLOAK_CLIENT_ID=authcenter
# KEYCLOAK_CLIENT_SECRET='your_keycloak_client_secret'
# 用 token 的哪個 claim 對應 MSSQL 的 nt_account（預設 preferred_username）
# KEYCLOAK_USERNAME_CLAIM=preferred_username
# claim 值帶網域（如 kane.beh@company.com）時填入網域：網域相符才接受，並去掉網域
# KEYCLOAK_USERNAME_DOMAIN=company.com
# Keycloak 憑證由內部 CA 簽發時，指向該 CA 的 PEM 檔
# KEYCLOAK_CA_BUNDLE=/etc/ssl/certs/company-ca.pem
# 使用者在登入頁看到的名稱，按鈕顯示「使用<名稱>登入」（預設「公司帳號」；使用者不會看到 Keycloak 字樣）
# KEYCLOAK_DISPLAY_NAME=公司帳號
# KEYCLOAK_SCOPE=openid profile email

# === Server ===
APP_PORT=8000
AUTH_CENTER_BASE_URL=http://localhost:8000

# === Super Admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
# 指定 MSSQL 員工為 Super Admin（逗號分隔，可與上方帳密並存）
SUPER_ADMIN_EMPLOYEES=kane.beh,john.doe
