# === IT Master DB (MSSQL - Read Only) ===
MSSQL_HOST=192.168.1.100
MSSQL_PORT=1433
MSSQL_USER=readonly_user
MSSQL_PASSWORD=your_mssql_password
MSSQL_DATABASE=it_master
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TABLE=staff

# === Auth Local DB (SQLite) ===
SQLITE_PATH=./auth_local.db

# === RSA Keys ===
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

# === Microsoft Teams Webhook ===
# 管理員 Channel 通知（忘記密碼、註冊請求等）
TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/xxx
# 使用者個人通知（透過 Power Automate Flow 發送 1:1 訊息）
# TEAMS_USER_WEBHOOK_URL=https://prod-xx.logic.azure.com/workflows/xxx
# 公司 Email 域名（用於 nt_account → email 對應，例如 kane.beh → kane.beh@company.com）
# COMPANY_EMAIL_DOMAIN=company.com
# HTTP Proxy（內網環境需透過 Proxy 連外網時設定）
# HTTP_PROXY=http://proxy.company.com:8080

# === Server ===
APP_PORT=8000
AUTH_CENTER_BASE_URL=http://localhost:8000

# === Super Admin ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
# 指定 MSSQL 員工為 Super Admin（逗號分隔，可與上方帳密並存）
SUPER_ADMIN_EMPLOYEES=kane.beh,john.doe
